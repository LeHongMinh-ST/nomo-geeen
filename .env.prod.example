# Copy to .env.prod and fill real values. Do not commit .env.prod.
BACKEND_PORT=8005
FRONTEND_PORT=3005

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nomogreen

JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_VALUE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_SECURE=true
CORS_ORIGIN=https://green.example.com
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Must be the public Cloudflare URL used by the browser, for example:
# https://api-green.example.com
NEXT_PUBLIC_API_BASE_URL=https://api-green.example.com
